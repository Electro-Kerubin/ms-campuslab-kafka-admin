# Brokers de Kafka (separados por coma)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# Con el Kafka de desarrollo de 1 broker (compose.dev.yml) los tópicos se crean con 1 réplica
KAFKA_ADAPT_REPLICATION=true

# Validación del JWT de Azure AD (tenant del proyecto)
TENANT_ID=changeme

# Puerto HTTP del servicio
SERVER_PORT=8087
